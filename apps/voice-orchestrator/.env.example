# Copy to .env for local development.
# Never commit a real .env file — see docs/08-security-observability-reliability.md §1.2.

NODE_ENV=development
PORT=3100

REDIS_URL=redis://localhost:6379

# core-api's base URL as this service's tool-broker client sees it
# (modules/tool-broker/infrastructure/http-core-api-client.ts) — include
# the `/v1` prefix core-api's global route prefix adds (main.ts).
CORE_API_BASE_URL=http://localhost:3000/v1
# A core-api API key with "full" scope, minted via core-api's own
# POST /v1/api-keys endpoint (owner/admin JWT required) — NOT self-generated
# like a local symmetric secret below. See docs/25-service-credential-provisioning.md
# for the exact request/response and why "full" (not "read_only") is the
# correct scope for this service's tool-broker calls.
CORE_API_SERVICE_API_KEY=

# Shared secret this service's own ServiceAuthGuard checks on every inbound
# request (shared/auth/service-auth.guard.ts) — the Voice Runtime (a
# separate service, not part of this repo) must present this as
# `Authorization: Bearer <token>`. Generate a real value with
# `openssl rand -base64 48`; this is a local-dev placeholder only, never a
# real secret, never committed as a real value.
ORCHESTRATOR_SERVICE_TOKEN=local_dev_only_orchestrator_token_change_me

LOG_LEVEL=info
OTEL_SERVICE_NAME=voice-orchestrator
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# AI provider credentials — all optional; a provider is simply absent from
# the fallback chain if its key isn't set (modules/ai-provider/ai-provider.module.ts).
# At least one is needed for any real conversation to work, but which
# one(s) is a deployment choice, not something this file mandates.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# GEMINI_API_KEY=
# GEMINI_BASE_URL=
# AI_PROVIDER_FALLBACK_ORDER=openai,anthropic,gemini
# DEFAULT_LLM_MODEL=
