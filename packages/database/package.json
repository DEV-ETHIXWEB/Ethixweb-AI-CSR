{
  "name": "@ethixweb/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema and generated client — single source of truth for the platform's PostgreSQL schema (docs/06-database-schema.md)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
    "format": "prisma format",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:setup-local-runtime-role": "node scripts/setup-local-runtime-role.mjs",
    "db:seed-local-pilot-tenant": "node scripts/seed-local-pilot-tenant.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^2.4.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "prisma": "^7.9.1",
    "typescript": "^5.6.3"
  }
}
