# Copy to .env for local development.
# Never commit a real .env file — see docs/08-security-observability-reliability.md §1.2.

NODE_ENV=development
PORT=3200

# --- LiveKit Cloud project (docs/02 §2's picked voice-runtime vendor) ---
# Picked up automatically by @livekit/agents' cli.runApp — not passed as
# explicit ServerOptions fields. All three required; there is no local
# stand-in for LiveKit's SFU/room service.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Outbound SIP trunk ID for emergency transfer (WarmTransferTask, agent.ts) —
# read directly by the SDK, not by config.ts. Only needed to test the
# forward_call path; see docs/27-voice-runtime-provisioning.md §5.
# LIVEKIT_SIP_OUTBOUND_TRUNK=

# --- Deepgram (STT) and Cartesia (TTS) — docs/21 §1's named reference
# adapters (DeepgramSttProvider / CartesiaTtsProvider). Both required for
# any real call; there is no local stand-in for either.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3
# A real Cartesia voice ID from your Cartesia account's voice library —
# picking a voice is a product/brand decision, not something to default
# to a placeholder that would silently ship as "whatever voice ID happened
# to be in this file." No default; the app fails fast at boot if unset.
CARTESIA_VOICE_ID=

# --- voice-orchestrator (the conversation "brain" this runtime drives via
# docs/24-runtime-orchestrator-contract.md's 5-endpoint HTTP contract) ---
ORCHESTRATOR_BASE_URL=http://localhost:3100/v1
# Must match voice-orchestrator's own ORCHESTRATOR_SERVICE_TOKEN exactly —
# a shared secret, not an issued credential. Generate a real value with
# `openssl rand -base64 48`; this is a local-dev placeholder only.
ORCHESTRATOR_SERVICE_TOKEN=local_dev_only_orchestrator_token_change_me

# --- Phase 1 static pilot config (docs/01 §9: single-tenant pilot) ---
# There is no DID->tenant lookup service yet — matches
# HttpCoreApiClient's own documented precedent (a single static
# CORE_API_SERVICE_API_KEY, not per-tenant credentials) for the same
# stated reason. Real per-DID tenant resolution is future multi-tenant
# work, not invented speculatively here.
PILOT_TENANT_ID=
PILOT_BUSINESS_ID=
PILOT_TIMEZONE=America/Chicago
# Comma-separated tool names — this call's agent config's allowlist
# (docs/04 §2 stage 2's authorization input), passed verbatim as
# HandleTurnDto.allowedTools on every turn.
PILOT_ALLOWED_TOOLS=searchCustomer,createCustomer,createLead,updateLead,getBusinessHours,getServiceAreas,escalateEmergency,lookupPreviousCalls

LOG_LEVEL=info
OTEL_SERVICE_NAME=voice-runtime
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
