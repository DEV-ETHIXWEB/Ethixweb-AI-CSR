{
  "name": "@ethixweb/voice-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Voice AI Orchestrator — conversation engine, tool broker, AI provider abstraction, prompt management (docs/01 §9 'Service: voice-orchestrator'). Owns everything AFTER audio is converted to structured events; the Voice Runtime (telephony/STT/TTS transport) is a separate service and an external client of this API.",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "jest --config jest.config.js",
    "test:integration": "jest --config jest.config.js --testPathPattern=nothing-yet",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand"
  },
  "dependencies": {
    "@ethixweb/shared-kernel": "workspace:*",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-fastify": "^10.4.6",
    "@nestjs/swagger": "^7.4.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.6",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.9.0",
    "@types/ioredis-mock": "^8.2.5",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
