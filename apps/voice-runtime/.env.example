# Copy to .env for local development.
# Never commit a real .env file — see docs/08-security-observability-reliability.md §1.2.

NODE_ENV=development
PORT=3200

# Public HTTPS URL this service is reachable at — an ngrok/Cloudflare
# Tunnel URL for local dev (docs/41), a real ALB/CloudFront URL in staging/
# prod. Used to (a) build the wss:// Media Stream URL embedded in outgoing
# TwiML and (b) reconstruct the exact URL Twilio signed for X-Twilio-Signature
# verification (TwilioSignatureGuard) — do not include a trailing slash.
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# --- voice-orchestrator (docs/28's contract) ---
VOICE_ORCHESTRATOR_BASE_URL=http://localhost:3100
# Shared secret with voice-orchestrator's own ORCHESTRATOR_SERVICE_TOKEN —
# must match EXACTLY (apps/voice-orchestrator/.env.example's own copy).
# Generate with `openssl rand -base64 48`; this is a local-dev placeholder,
# never a real secret.
ORCHESTRATOR_SERVICE_TOKEN=local_dev_only_orchestrator_token_change_me

# --- Twilio (this service's OWN Voice credentials — NEVER core-api's
# TWILIO_AUTH_TOKEN, which is for an unrelated outbound-SMS feature/
# sub-account, see docs/39) ---
# From the Twilio Console (https://console.twilio.com) — Account SID and
# Auth Token are on the account dashboard; the Auth Token doubles as both
# the X-Twilio-Signature verification secret AND the Twilio REST API
# basic-auth password for call transfers (twilio-call-transfer.provider.ts).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The E.164 number this deployment expects inbound calls on (informational —
# TenantRoutingProvider reads the actual dialed number per-request, not this var).
TWILIO_PHONE_NUMBER=
# Local-dev-only escape hatch — skips X-Twilio-Signature verification.
# NEVER true in staging/production. See TwilioSignatureGuard's own comment.
TWILIO_SIGNATURE_VALIDATION_DISABLED=false
# E.164 destination this runtime transfers to when escalateEmergency
# returns action:"forward_call" (docs/28 §M) — a real on-call number/queue,
# not configured here to any default (no safe default exists for this).
EMERGENCY_TRANSFER_NUMBER=

# --- Deepgram STT (https://console.deepgram.com — API key under "API Keys") ---
DEEPGRAM_API_KEY=
# Optional — defaults to nova-2-phonecall (Deepgram's telephony-tuned model)
# if unset. See deepgram-stt.provider.ts.
# DEEPGRAM_MODEL=nova-2-phonecall

# --- ElevenLabs TTS (https://elevenlabs.io — API key under Profile Settings) ---
ELEVENLABS_API_KEY=
# A real voice ID from your ElevenLabs account (Voice Library or a cloned
# voice) — there is no safe platform-wide default, this is tenant/brand
# specific.
ELEVENLABS_VOICE_ID=
# Optional — defaults to eleven_turbo_v2_5 (ElevenLabs' lowest-latency
# model, appropriate for real-time phone conversation) if unset.
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Tenant routing (docs/28 §B.1: resolving toNumber -> tenantId/businessId
# is this runtime's own telephony-provisioning responsibility) ---
# Single-tenant deployment (the realistic mode for the FIRST real call,
# docs/41) — every inbound call maps to this one tenant regardless of which
# number it landed on:
TENANT_ROUTING_DEFAULT_TENANT_ID=
TENANT_ROUTING_DEFAULT_BUSINESS_ID=
TENANT_ROUTING_DEFAULT_TIMEZONE=America/Chicago
# Multi-number deployment (optional, takes priority over the DEFAULT_* vars
# above on an exact match) — JSON array of {toNumber, tenantId, businessId, timezone}:
# TENANT_ROUTING_MAP=[{"toNumber":"+15551234567","tenantId":"...","businessId":"...","timezone":"America/Chicago"}]

LOG_LEVEL=info
OTEL_SERVICE_NAME=voice-runtime
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
