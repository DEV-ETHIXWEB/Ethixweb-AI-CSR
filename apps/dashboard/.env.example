# Server-side only — never exposed to the browser (no NEXT_PUBLIC_ prefix).
# This app's own Route Handlers/Server Components proxy every core-api call,
# so the browser never talks to core-api directly and CORS is deliberately
# NOT required on core-api's side for this dashboard to function (see
# src/lib/session.ts's own comment for the full reasoning).
CORE_API_BASE_URL=http://localhost:3000
