# Copy to .env for local development (docker-compose.yml provides matching Postgres/Redis).
# Never commit a real .env file — see docs/08-security-observability-reliability.md §1.2.

NODE_ENV=development
PORT=3000

# Two distinct roles, per docs/20-architecture-decision-records.md ADR-013/ADR-014 —
# never point both at the same role, or Row-Level Security silently stops
# being enforced (the table owner always bypasses RLS regardless of policy).
#
# MIGRATION_DATABASE_URL: the table-owning role. Used only by `prisma
#   migrate`/`generate` (see packages/database/prisma.config.ts) and by this
#   docker-compose Postgres's own bootstrap user — never by the running app.
MIGRATION_DATABASE_URL=postgresql://ethixweb:ethixweb_local_dev@localhost:5432/ethixweb_csr?schema=public
# DATABASE_URL: the app's actual runtime connection, as the non-owning,
#   RLS-subject `app_runtime` role created by the RLS migration. Run
#   `pnpm --filter @ethixweb/database run db:setup-local-runtime-role` once
#   after your first `migrate:dev` to set this password locally (it's not a
#   real secret — see that script's own comment for why).
DATABASE_URL=postgresql://app_runtime:local_dev_only_app_runtime@localhost:5432/ethixweb_csr?schema=public

REDIS_URL=redis://localhost:6379

# Two DIFFERENT secrets, deliberately — a leaked access-token signing key
# (used on every request) must not be usable to forge a long-lived refresh
# token, and vice versa. See modules/auth/infrastructure/jwt-token.service.ts.
# Generate real values with `openssl rand -base64 48` — these are local-dev
# placeholders only, never real secrets, never committed as real values.
JWT_ACCESS_SECRET=local_dev_only_access_secret_change_me
JWT_REFRESH_SECRET=local_dev_only_refresh_secret_change_me
# JWT_ACCESS_TTL_SECONDS=900        # default 15 min, per docs/08 §1.1
# JWT_REFRESH_TTL_SECONDS=2592000   # default 30 days

LOG_LEVEL=info
OTEL_SERVICE_NAME=core-api
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# 32-byte (64 hex char) key for the local AES-256-GCM envelope-encryption
# stand-in for the real AWS KMS design (docs/08 §1.2) — see
# modules/crm/infrastructure/aes-gcm-credential-encryptor.ts for why this is
# a stand-in, not the production mechanism. Generate a real value with
# `openssl rand -hex 32`; this placeholder is local-dev only.
INTEGRATION_CREDENTIALS_MASTER_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Housecall Pro's exact API base URL was not confirmed against a live
# sandbox account (docs/05-crm-integration.md §2.9) — set per environment
# once confirmed; a per-integration credential.baseUrl overrides this.
# HOUSECALL_PRO_API_BASE_URL=https://api.housecallpro.com

# Twilio's Account Auth Token (from the Twilio console, Account ->
# API keys & tokens — not self-generated like the secrets above). Used
# both to sign outbound Messages API requests (infrastructure/senders/twilio-sms.sender.ts)
# and to verify the X-Twilio-Signature header on inbound webhooks
# (modules/notifications/interfaces/guards/twilio-signature.guard.ts, per
# docs/08-security-observability-reliability.md §1.3). Optional at
# config-validation boot time (see shared/config/env.schema.ts) the same
# way HOUSECALL_PRO_API_BASE_URL is — the SMS claim-reply webhook fails
# closed with 403 on every request if this is unset, rather than the whole
# app refusing to boot over one optional integration.
# TWILIO_AUTH_TOKEN=
